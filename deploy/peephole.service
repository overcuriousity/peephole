[Unit]
Description=peephole — scan-the-scanners honeypot
After=network-online.target
Wants=network-online.target

# Local changes (limits, sandboxing, environment) belong in a drop-in:
# systemctl edit peephole. The installer never touches drop-ins; an edited
# copy of this file is kept on upgrade and the new one is placed beside it as
# peephole.service.new.

[Service]
# peephole tells systemd once its listeners are bound (sd_notify READY=1),
# so "systemctl start" fails if it cannot start.
Type=notify
User=root
ExecStart=/usr/local/bin/peephole /etc/peephole/config.toml
Restart=on-failure
RestartSec=5
# A start may migrate the database or bring a node's history into a cluster.
TimeoutStartSec=5min
# A scanner flood opens many connections at once; the default 1024 runs out.
LimitNOFILE=65536
# Runs as root (nmap -sS/-O), but with only the capabilities it uses: raw
# sockets for nmap, low ports for listeners, reading operator files whatever
# their mode. nmap is spawned with fixed argv, no shell.
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
NoNewPrivileges=true
# Only options that need no mount namespace: these also work in unprivileged
# LXC containers without nesting. AF_PACKET and AF_NETLINK are nmap's.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
